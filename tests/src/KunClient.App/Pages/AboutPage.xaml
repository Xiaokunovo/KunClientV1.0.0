<services:BasePage x:Class="KunFlashTool.App.Pages.AboutPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:services="clr-namespace:KunFlashTool.App.Services">
    <!-- 经典工具箱版式（配方见 docs/ui-toolbox-skin.md）：
         ① 页面标题栏（ctrl:PageHeaderBar）已删除 —— 页签名「关于」就是标题；
         ② 底色画在页面根 Grid 上并取 Theme.BgTint（全局「界面透明」改的就是它的 alpha）；
         ③ 每个分区（版本信息 / 合规承诺 / 功能范围 / 联系方式 / 反馈人员 / 关于收费 / 免责声明 / 开源许可证）
            都换成 ToolGroup 分组框：白底 + 1px 灰描边 + 标题压在边框线上，组内不再套 Padding；
            原来每个卡片里那行 <TextBlock Text="X" Style="{StaticResource SectionHeader}"/> 标题已删（挪到 Header 上）；
         ④ 读数用「标签: 值」两列（ToolFieldLabel / ToolFieldValue），沿用原卡片的分区顺序；
         ⑤ 仍保留 ScrollViewer：内容高，窄窗口要能滚动；
         ⑥ 字号档位：正文 12 / 标签 11 / 分组标题 12.5；品牌行「KunClient」用参考页
            DeviceHomePage 品牌行同款（F.Mono · 14 · Bold —— 规范里对关于页品牌行的例外档），
            版权行 11。本页纯静态信息，唯一 x:Name 是 TxtVersion（代码写版本号）。 -->
    <Grid Background="{DynamicResource Theme.BgTint}" Margin="{StaticResource Tool.PagePad}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center">

                <!-- ═══════════ 版本信息 ═══════════ -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="版本信息">
                    <StackPanel>
                        <!-- 品牌（纯文字，不再放独立的图形 logo）。
                             字号走参考页 DeviceHomePage 品牌行同款（等宽 14 Bold），
                             不再用 24pt 大字 —— 换肤规范里关于页品牌行的唯一例外档。
                             ⚠️ Kun / KunClient 的分色是刻意的品牌样式：外层容器可以改，
                                里面 <Run Text="Kun"/> + <Run Text="Client" .../> 的写法保留。 -->
                        <TextBlock FontSize="14" FontWeight="Bold" FontFamily="{StaticResource F.Mono}"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Theme.TextPrimary}">
                            <Run Text="Kun"/><Run Text="Client" Foreground="{DynamicResource Theme.AccentText2}"/>
                        </TextBlock>

                        <!-- 版本 / 作者：经典「标签: 值」两列读数 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="版本:" Style="{StaticResource ToolFieldLabel}"/>
                            <!-- 版本号由代码写入。**值里不带前缀** —— 左边标签已是「版本:」，再加 Ver: 会重复。 -->
                            <TextBlock x:Name="TxtVersion" Grid.Row="0" Grid.Column="1" Text="1.0.0"
                                       Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="作者:" Style="{StaticResource ToolFieldLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="小坤ovo"
                                       Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                       Foreground="{DynamicResource Theme.AccentText2}"/>
                        </Grid>

                        <!-- 简介横幅：保留原来的强调底色（换肤只改分组框与读数，不删既有视觉元素） -->
                        <Border Background="{DynamicResource Theme.AccentSubtle}" CornerRadius="{StaticResource R.Dialog}"
                                Padding="12,8" Margin="0,8,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="高通 EDL 线刷工具" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource Theme.AccentText2}" TextAlignment="Center"/>
                                <TextBlock Text="ADB · Fastboot · EDL · 投屏 · 分区管理" FontSize="12"
                                           Foreground="{DynamicResource Theme.TextSecondary}" TextAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- ═══════════ 合规承诺 ═══════════ -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="合规承诺">
                    <TextBlock FontSize="12" LineHeight="21" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextSecondary}">
                        <Run Text="1." FontWeight="SemiBold" Foreground="{DynamicResource Theme.LogSuccess}"/>
                        <Run Text=" 本工具仅用于对本人合法所有、或已获得所有者明确授权的设备进行系统维护与刷写；严禁用于来历不明、遗失或被盗的设备。"/>
                        <LineBreak/>
                        <Run Text="2." FontWeight="SemiBold" Foreground="{DynamicResource Theme.LogSuccess}"/>
                        <Run Text=" 不提供、不内置任何用于绕过设备安全机制、窃取数据或规避账号保护的功能。"/>
                        <LineBreak/>
                        <Run Text="3." FontWeight="SemiBold" Foreground="{DynamicResource Theme.LogSuccess}"/>
                        <Run Text=" 不采集、不上传、不留存设备唯一标识（序列号 / Android ID）。登录来源 IP 由服务端在登录时记录于登录日志（仅开发者可见），客户端本身不上报任何网络地址信息。"/>
                        <LineBreak/>
                        <Run Text="4." FontWeight="SemiBold" Foreground="{DynamicResource Theme.LogSuccess}"/>
                        <Run Text=" 涉及高风险操作时会先要求确认设备归属，未确认不予执行。"/>
                    </TextBlock>
                </HeaderedContentControl>

                <!-- ═══════════ 功能范围 ═══════════
                     左列名称（ToolFieldLabel）+ 右列说明（ToolFieldValue，右对齐）—— 经典读数表。 -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="功能范围">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="EDL 线刷" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="9008 模式引导、分区读写与备份"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fastboot" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="分区刷写与设备状态查询"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="ADB 工具集" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="应用管理 · 文件传输 · 投屏"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="本地与云端" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="资料本地处理，引导库按需下载"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </HeaderedContentControl>

                <!-- ═══════════ 联系方式 ═══════════ -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="联系方式">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="QQ:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="2089449185"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="2089449185@qq.com"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </HeaderedContentControl>

                <!-- ═══════════ 反馈人员 ═══════════
                     反馈人员单独成块 —— 贡献形式与代码/资源类投入不同（偏缺陷与体验问题上报），
                     混在一起会丢掉这层身份。
                     🔴 开源版已移除原先的「鸣谢」区块（内含真实姓名与 QQ 号）；
                        如需恢复请只保留昵称，不要放联系方式。 -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="反馈人员">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="河南省省长-青墨" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="QQ: 2117598242"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="♂甩@棍🇨🇳" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="QQ: 2433862624"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="是宝不是贝^" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="QQ: 1781653834"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </HeaderedContentControl>

                <!-- ═══════════ 关于收费 ═══════════
                     与控制台「正式版」FAQ 同一口径：收费仅用于维护工具与服务器。 -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="关于收费">
                    <TextBlock FontSize="12" LineHeight="21" TextWrapping="Wrap"
                               Foreground="{DynamicResource Theme.TextSecondary}"
                               Text="工具收费只会用于维护工具与维护服务器，不会用于其他用途。"/>
                </HeaderedContentControl>

                <!-- ═══════════ 免责声明 ═══════════
                     原卡片里那行警告色的「免责声明」小标题已挪到分组框 Header 上，
                     警告强调改落在正文最后那句「请在操作前务必备份重要数据。」（同色系，仍是 Theme.LogWarning）。
                     正文 12（规范正文档，不用 11.5 半档）。 -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="免责声明">
                    <TextBlock FontSize="12" Foreground="{DynamicResource Theme.TextSecondary}" TextWrapping="Wrap" LineHeight="20">
                        本工具仅供学习交流与合法的设备维护使用。刷机操作存在风险，包括但不限于设备无法开机、数据丢失、失去保修等。
                        使用本工具即表示您已了解并接受上述风险，并自行承担相应后果；因违规使用（包括对非本人授权设备操作）产生的一切责任由使用者自负。
                        <LineBreak/>
                        <Run Text="请在操作前务必备份重要数据。" FontWeight="SemiBold" Foreground="{DynamicResource Theme.LogWarning}"/>
                    </TextBlock>
                </HeaderedContentControl>

                <!-- ═══════════ MIT 开源许可证 ═══════════ -->
                <HeaderedContentControl Style="{StaticResource ToolGroup}" Header="MIT 开源许可证">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="许可证:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="MIT"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="授权:" Style="{StaticResource ToolFieldLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="自由使用、修改和分发"
                                   Height="{StaticResource Tool.RowHeight}" Style="{StaticResource ToolFieldValue}"/>
                    </Grid>
                </HeaderedContentControl>

                <TextBlock Text="© 2024-2026 KunClient" FontSize="11"
                           Foreground="{DynamicResource Theme.TextTertiary}"
                           HorizontalAlignment="Center" Margin="0,4,0,4"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</services:BasePage>
